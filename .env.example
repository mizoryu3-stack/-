# SQLiteのDBファイルパス
DATABASE_URL="file:./dev.db"

# 外部データ取込API(/api/properties/ingest)の認証トークン。
# 未設定の場合、このAPIは常に501を返して無効化される。
# 実際に外部からデータを取り込む段階になったら設定すること。
INGEST_API_TOKEN=

# 日次自動探索API(/api/cron/daily-search)の認証トークン。
# 未設定の場合、このAPIは常に501を返して無効化される。
# 外部スケジューラ（Vercel Cron等）から1日1回叩く際、リクエストヘッダー
# `x-cron-token` にこの値を設定すること。
CRON_API_TOKEN=

# 新着物件のメール通知(STEP8)で使うメールアダプタの選択。
# 未設定（既定）: メール送信自体を行わない（外部メールサービス未契約でも安全に動作する）。
# "console": ローカル開発用。実際には送信せず、内容をコンソールに出力するだけ。
# 将来Resend等の実サービスを導入する場合はこの変数の値を追加し、対応するAdapterを
# src/lib/notifications/email/adapters/ に実装する（テスト専用の"fake"は本番では使わない）。
EMAIL_PROVIDER=

# 新着物件のメール通知の送信先アドレス。認証機能未実装のため単一ユーザー固定。
# 未設定の場合、EMAIL_PROVIDERを設定していても送信をスキップする。
NOTIFICATION_EMAIL_TO=

# メール本文に含める物件詳細ページへのリンクのベースURL。
# 未設定の場合、ローカル開発用の既定値(http://localhost:3000)を使う。
APP_BASE_URL=

# 国土交通省「不動産情報ライブラリ」APIキー。
# 取得方法: https://www.reinfolib.mlit.go.jp/api/request/ から利用申請を行うと
# 数営業日でメールでAPIキーが発行される（個人区分あり・無料）。
#
# 未設定でもアプリは問題なく動作する。その場合、地価・用途地域・駅利用者数・
# 災害リスクなどの公的データ(PublicDataSnapshot)は取得されず、
# 民泊適性スコアの該当項目は中立点として扱われ、
# 「公的データを取得できませんでした」という理由が表示されるだけになる。
REINFOLIB_API_KEY=
