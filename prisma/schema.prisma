// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum BuildingType {
  HOUSE // 戸建て
  APARTMENT // マンション
}

// 物件の掲載状態。将来、外部データを定期的に再取得して既存物件と照合し、
//   確認できた → ACTIVE（lastSeenAt/lastCheckedAt更新）
//   一定期間確認できない → ENDED または UNKNOWN
// と遷移させる想定（自動照合処理そのものは未実装。src/lib/ingestion/reconcileListingStatus.ts 参照）。
enum ListingStatus {
  ACTIVE // 掲載中
  ENDED // 掲載終了（確認の結果、掲載が終了したと判断したもの）
  UNKNOWN // 確認できない（再取得に失敗した、まだ照合していない等）
}

// 物件データ本体。
//
// アプリのデータフローは
//   外部物件データ → データ取得レイヤー(src/lib/ingestion) → Property(DB) → 民泊分析(src/lib/score.ts) → 検索画面
// という構成になっており、source* 系のフィールドはそのうち「どこから来たデータか」を記録するためのもの。
// 現時点では手入力・ダミーデータ(source = "manual")のみで、SUUMO 等からの自動取得は行っていない。
model Property {
  id             Int          @id @default(autoincrement())
  name           String // 物件名
  prefecture     String // 都道府県（例: 広島県）。現時点では広島県のみ対応（src/lib/regions.ts参照）
  city           String // 市区町村（例: 広島市中区）。src/lib/regions.ts の対応エリアのいずれか
  address        String // 住所（表示用の完全な住所文字列）
  buildingType   BuildingType // 戸建て / マンション
  rent           Int // 家賃（円/月）
  managementFee  Int          @default(0) // 管理費（円/月）
  layout         String // 間取り（例: 1LDK）
  areaSqm        Float // 専有面積（m2）
  builtYear      Int // 築年（西暦）
  stationName    String? // 最寄り駅名
  stationWalkMin Int // 駅徒歩（分）
  hasParking     Boolean      @default(false) // 駐車場の有無
  deposit        Int          @default(0) // 敷金（円）
  keyMoney       Int          @default(0) // 礼金（円）
  initialCost    Int? // 初期費用（円、任意。敷金礼金込みの想定初期投資額）
  photoUrl       String? // 物件写真URL（未設定の場合はプレースホルダー表示）
  memo           String? // メモ

  // 緯度経度（任意）。国土交通省 不動産情報ライブラリ等の位置情報APIを叩くために使用。
  // 現時点では自動ジオコーディングは実装しておらず、手入力データのみ手動で設定している。
  latitude  Float?
  longitude Float?

  // --- データ出所（外部データ取込レイヤー用。STEP5） ---
  source     String  @default("manual") // "manual" | "suumo" | "homes" | "athome" など。将来のソース追加はアダプタを増やすだけでよい
  externalId String? // 外部サイト側の物件ID（重複取込防止の基本キー。手入力データはnull）
  sourceUrl  String? // 元データのURL（任意）

  // --- 掲載状態のライフサイクル管理 ---
  listingStatus ListingStatus @default(ACTIVE)
  firstSeenAt   DateTime      @default(now()) // 初めて確認した日時（新規取込時に設定、以後更新しない）
  lastSeenAt    DateTime      @default(now()) // 最後に「掲載中」と確認できた日時
  lastCheckedAt DateTime      @default(now()) // 最後に状態確認を試みた日時（確認できたか否かに関わらず更新）

  // 民泊適性スコア（0-100）。src/lib/score.ts の仮ロジックで算出し、取込時点の値をキャッシュしている。
  // 「参考スコア」であり、法的な民泊可否を確定するものではない。
  minpakuScore Int

  simulationInput    SimulationInput?
  favorite           Favorite?
  nearbyAttractions  NearbyAttraction[]
  competitors        CompetitorListing[]
  publicDataSnapshot PublicDataSnapshot?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // 同一ソース内での重複取込を防止する基本キー（手入力データは externalId が null のため対象外）。
  // externalId が無い場合の重複判定は src/lib/ingestion/duplicateDetection.ts 参照（未実装の拡張ポイント）。
  @@unique([source, externalId])
}

// 周辺観光地（民泊適性スコアの「観光地の近さ」要素、および詳細画面の表示に使用）
// 現時点では手入力のサンプル値。将来的にGoogle Maps等のPlaces APIから自動補完することを想定。
model NearbyAttraction {
  id         Int      @id @default(autoincrement())
  propertyId Int
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  name       String // 観光地名（例: 宮島・嚴島神社）
  distanceKm Float // 物件からの概算距離（km）
}

// 周辺の競合民泊（民泊適性スコアの「競合の少なさ」要素に使用）
// 現時点では手入力のサンプル件数。将来的には周辺の民泊掲載サイトの件数取得等を想定。
model CompetitorListing {
  id         Int      @id @default(autoincrement())
  propertyId Int
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  platform   String? // 掲載プラットフォーム名（例: Airbnb）任意
  distanceKm Float // 物件からの概算距離（km）
}

// 国土交通省「不動産情報ライブラリ」等の公的データから取得した、物件周辺の参考情報。
// Propertyと1:1。あくまで「周辺環境・立地・災害リスクの参考評価」であり、
// 民泊営業の可否や安全性を保証・確定するものではない（src/lib/publicData/types.ts の
// PUBLIC_DATA_DISCLAIMER を参照）。
//
// 取得はベストエフォートで行い、APIキー未設定・通信エラー・対象データなし等が発生しても
// 取り込み処理自体は失敗させず、fetchStatus/fetchNoteに状況を記録するのみとする。
model PublicDataSnapshot {
  id         Int      @id @default(autoincrement())
  propertyId Int      @unique
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  // "OK"（全項目取得成功） / "PARTIAL"（一部のみ取得成功） /
  // "UNAVAILABLE"（APIキー未設定・全滅等） / "SKIPPED"（緯度経度未設定のため未実施）
  fetchStatus String
  fetchNote   String? // 画面表示用の補足（例:「公的データを取得できませんでした」）

  // 取引価格情報API(XIT001)による、同一市区町村・直近四半期の取引単価の平均（参考値）
  areaAvgUnitPricePerSqm Int?
  areaPriceYear          Int?
  areaPriceQuarter       Int?

  // 用途地域API(XKT002)
  useZone String?

  // 駅別乗降客数API(XKT015)
  stationDailyUsers Int?
  stationUsageYear  Int?

  // 防災系API(XKT026/027/028/029)。該当タイル内に該当区域があるかの簡易判定（真偽値）。
  floodRiskArea      Boolean?
  tsunamiRiskArea    Boolean?
  landslideRiskArea  Boolean?
  stormSurgeRiskArea Boolean?

  fetchedAt DateTime @default(now())
}

// 収益シミュレーションの「初期値・保存された編集値」
// 実際の売上/利益はUI側で都度計算する（保存はしない）
model SimulationInput {
  id            Int      @id @default(autoincrement())
  propertyId    Int      @unique
  property      Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  nightlyPrice  Int // 想定宿泊単価（円/泊）
  occupancyRate Float // 想定稼働率（0.0〜1.0）
  utilityCost   Int // 水道光熱費（円/月）
  cleaningCost  Int // 清掃費（円/月）
  suppliesCost  Int // 消耗品費（円/月）
  otaFeeRate    Float    @default(0.15) // OTA(Airbnb等)手数料率（0.0〜1.0、売上に対する割合）
  otherCost     Int // その他経費（円/月）
  updatedAt     DateTime @updatedAt
}

// お気に入り（プロトタイプにつきユーザー識別なしの単一ユーザー想定）
model Favorite {
  id         Int      @id @default(autoincrement())
  propertyId Int      @unique
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
}
