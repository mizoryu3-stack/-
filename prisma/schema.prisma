// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum BuildingType {
  HOUSE // 戸建て
  APARTMENT // マンション
}

// 物件の掲載状態。将来、外部データを定期的に再取得して既存物件と照合し、
//   確認できた → ACTIVE（lastSeenAt/lastCheckedAt更新）
//   一定期間確認できない → ENDED または UNKNOWN
// と遷移させる想定。自動照合処理自体はsrc/lib/ingestion/reconcileListingStatus.tsに実装済みで、
// 日次自動探索(src/lib/ingestion/runDailySearch.ts)から呼ばれる（実データソースが0件のため
// 現時点では実運用で発火しない）。
enum ListingStatus {
  ACTIVE // 掲載中
  ENDED // 掲載終了（確認の結果、掲載が終了したと判断したもの）
  UNKNOWN // 確認できない（再取得に失敗した、まだ照合していない等）
}

// 民泊利用について、物件提供元（不動産会社等）から得られた「確認状況」。
//
// 重要: これはオーナー・仲介元からのヒアリング状況を表すだけであり、
// 住宅宿泊事業法・旅館業許可・マンション管理規約・自治体条例等に基づく
// 法的な民泊可否をアプリが断定するものではない（民泊適性スコア同様、参考情報）。
//
// ListingStatus（掲載自体が生きているか）とは完全に別概念であり、混同しないこと。
enum MinpakuConsultationStatus {
  OWNER_CONFIRMED_AVAILABLE // オーナー確認済み・民泊利用について相談可能
  OWNER_CONFIRM_REQUIRED // 民泊利用についてオーナー確認が必要
  NOT_AVAILABLE // 民泊利用不可
  UNKNOWN // 民泊利用について未確認
}

// 物件データ本体。
//
// アプリのデータフローは
//   外部物件データ → データ取得レイヤー(src/lib/ingestion) → Property(DB) → 民泊分析(src/lib/score.ts) → 検索画面
// という構成になっており、source* 系のフィールドはそのうち「どこから来たデータか」を記録するためのもの。
// 現時点では手入力・ダミーデータ(source = "manual")のみで、SUUMO 等からの自動取得は行っていない。
model Property {
  id             Int          @id @default(autoincrement())
  name           String // 物件名
  prefecture     String // 都道府県（例: 広島県）。現時点では広島県のみ対応（src/lib/regions.ts参照）
  city           String // 市区町村（例: 広島市中区）。src/lib/regions.ts の対応エリアのいずれか
  address        String // 住所（表示用の完全な住所文字列）
  buildingType   BuildingType // 戸建て / マンション
  rent           Int // 家賃（円/月）
  managementFee  Int          @default(0) // 管理費（円/月）
  layout         String // 間取り（例: 1LDK）
  areaSqm        Float // 専有面積（m2）
  builtYear      Int // 築年（西暦）
  stationName    String? // 最寄り駅名
  stationWalkMin Int // 駅徒歩（分）
  hasParking     Boolean      @default(false) // 駐車場の有無
  deposit        Int          @default(0) // 敷金（円）
  keyMoney       Int          @default(0) // 礼金（円）
  initialCost    Int? // 初期費用（円、任意。敷金礼金込みの想定初期投資額）
  photoUrl       String? // 物件写真URL（未設定の場合はプレースホルダー表示）
  memo           String? // メモ（自由記述。民泊相談可否等の確認状況はここに書かず minpakuConsultationStatus を使う）

  // 民泊利用について物件提供元から得た確認状況（法的な可否の断定ではない参考情報）。
  // 詳細は MinpakuConsultationStatus enum のコメントを参照。
  minpakuConsultationStatus MinpakuConsultationStatus @default(UNKNOWN)

  // 緯度経度（任意）。国土交通省 不動産情報ライブラリ等の位置情報APIを叩くために使用。
  // 現時点では自動ジオコーディングは実装しておらず、手入力データのみ手動で設定している。
  latitude  Float?
  longitude Float?

  // --- データ出所（外部データ取込レイヤー用。STEP5） ---
  source     String  @default("manual") // "manual" | "suumo" | "homes" | "athome" など。将来のソース追加はアダプタを増やすだけでよい
  externalId String? // 外部サイト側の物件ID（重複取込防止の基本キー。手入力データはnull）
  sourceUrl  String? // 元データのURL（任意）

  // --- 掲載状態のライフサイクル管理 ---
  listingStatus ListingStatus @default(ACTIVE)
  firstSeenAt   DateTime      @default(now()) // 初めて確認した日時（新規取込時に設定、以後更新しない）
  lastSeenAt    DateTime      @default(now()) // 最後に「掲載中」と確認できた日時
  lastCheckedAt DateTime      @default(now()) // 最後に状態確認を試みた日時（確認できたか否かに関わらず更新）

  // 民泊適性スコア（0-100）。src/lib/score.ts の仮ロジックで算出し、取込時点の値をキャッシュしている。
  // 「参考スコア」であり、法的な民泊可否を確定するものではない。
  minpakuScore Int

  simulationInput    SimulationInput?
  favorite           Favorite?
  nearbyAttractions  NearbyAttraction[]
  competitors        CompetitorListing[]
  publicDataSnapshot PublicDataSnapshot?
  // 重複候補: このPropertyが「新規取込側」として記録した候補、および「既存の類似物件側」として記録された候補
  duplicatesAsNew      DuplicateCandidate[] @relation("DuplicateCandidateProperty")
  duplicatesAsExisting DuplicateCandidate[] @relation("DuplicateCandidateOf")
  propertyMatches      PropertyMatch[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // 同一ソース内での重複取込を防止する基本キー（手入力データは externalId が null のため対象外）。
  // externalId が無い場合の重複判定は src/lib/ingestion/duplicateDetection.ts 参照（未実装の拡張ポイント）。
  @@unique([source, externalId])
}

// 周辺観光地（民泊適性スコアの「観光地の近さ」要素、および詳細画面の表示に使用）
// 現時点では手入力のサンプル値。将来的にGoogle Maps等のPlaces APIから自動補完することを想定。
model NearbyAttraction {
  id         Int      @id @default(autoincrement())
  propertyId Int
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  name       String // 観光地名（例: 宮島・嚴島神社）
  distanceKm Float // 物件からの概算距離（km）
}

// 周辺の競合民泊（民泊適性スコアの「競合の少なさ」要素に使用）
// 現時点では手入力のサンプル件数。将来的には周辺の民泊掲載サイトの件数取得等を想定。
model CompetitorListing {
  id         Int      @id @default(autoincrement())
  propertyId Int
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  platform   String? // 掲載プラットフォーム名（例: Airbnb）任意
  distanceKm Float // 物件からの概算距離（km）
}

// 国土交通省「不動産情報ライブラリ」等の公的データから取得した、物件周辺の参考情報。
// Propertyと1:1。あくまで「周辺環境・立地・災害リスクの参考評価」であり、
// 民泊営業の可否や安全性を保証・確定するものではない（src/lib/publicData/types.ts の
// PUBLIC_DATA_DISCLAIMER を参照）。
//
// 取得はベストエフォートで行い、APIキー未設定・通信エラー・対象データなし等が発生しても
// 取り込み処理自体は失敗させず、fetchStatus/fetchNoteに状況を記録するのみとする。
model PublicDataSnapshot {
  id         Int      @id @default(autoincrement())
  propertyId Int      @unique
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  // "OK"（全項目取得成功） / "PARTIAL"（一部のみ取得成功） /
  // "UNAVAILABLE"（APIキー未設定・全滅等） / "SKIPPED"（緯度経度未設定のため未実施）
  fetchStatus String
  fetchNote   String? // 画面表示用の補足（例:「公的データを取得できませんでした」）

  // 取引価格情報API(XIT001)による、同一市区町村・直近四半期の取引単価の平均（参考値）
  areaAvgUnitPricePerSqm Int?
  areaPriceYear          Int?
  areaPriceQuarter       Int?

  // 用途地域API(XKT002)
  useZone String?

  // 駅別乗降客数API(XKT015)
  stationDailyUsers Int?
  stationUsageYear  Int?

  // 防災系API(XKT026/027/028/029)。該当タイル内に該当区域があるかの簡易判定（真偽値）。
  floodRiskArea      Boolean?
  tsunamiRiskArea    Boolean?
  landslideRiskArea  Boolean?
  stormSurgeRiskArea Boolean?

  fetchedAt DateTime @default(now())
}

enum DuplicateCandidateStatus {
  PENDING // 未確認（管理画面でのレビュー待ち）
  CONFIRMED // 人が確認し、実際に重複だったと判断したもの
  DISMISSED // 人が確認し、重複ではないと判断したもの
}

// 重複の可能性がある物件のペアを記録する（自動統合はしない）。
// externalId・sourceUrl による完全一致では判定できず、物件名・住所の類似度や
// 座標の近接度から「重複かもしれない」と検出された場合にのみ作成される。
// src/lib/ingestion/duplicateDetection.ts 参照。
model DuplicateCandidate {
  id                  Int      @id @default(autoincrement())
  propertyId          Int // 新しく取り込まれた物件
  property            Property @relation("DuplicateCandidateProperty", fields: [propertyId], references: [id], onDelete: Cascade)
  candidatePropertyId Int // 類似していると判定された既存物件
  candidateProperty   Property @relation("DuplicateCandidateOf", fields: [candidatePropertyId], references: [id], onDelete: Cascade)
  reason              String // 判定理由（例:「住所が類似」「物件名が類似」「座標が近接」）
  similarity          Float // 0.0〜1.0の類似度の目安
  status              DuplicateCandidateStatus @default(PENDING)
  createdAt           DateTime                 @default(now())
}

// CSVインポート等、一括取込の実行履歴。
// 取込結果（件数・エラー内容）を後から管理画面で確認できるようにするための監査ログ。
model ImportBatch {
  id                      Int      @id @default(autoincrement())
  source                  String // 取込元識別子（例: "csv"）
  fileName                String?
  totalRows               Int
  createdCount            Int
  updatedCount            Int
  errorCount              Int
  duplicateCandidateCount Int
  // 行単位のエラー一覧をJSON文字列として保存: [{ "row": 3, "message": "家賃が不正です" }, ...]
  errorsJson              String?
  createdAt               DateTime @default(now())
}

enum SearchRunStatus {
  RUNNING // 実行中
  COMPLETED // 完了（対象ソース0件、または全ソース成功／一部ソース失敗を含む）
  FAILED // 全ソースが失敗した、またはオーケストレーション自体が予期せず失敗した
}

enum SearchRunSourceStatus {
  SUCCEEDED // このソースの取得・取込処理は最後まで完了した（個々の行のエラーは別途errorCountで管理）
  FAILED // このソースの取得・取込処理自体が例外で中断した（他ソースの処理は継続する）
}

// 日次自動探索（STEP1: /api/cron/daily-search）1回分の実行記録。
//
// ImportBatchは「CSVファイル1つのアップロード」専用の監査ログのため転用せず、
// 複数ソースを横断する日次実行はこちらに記録する。1回のSearchRunに対し、
// 対象ソースごとの内訳を SearchRunSource として保持する。
//
// 現時点では PROVIDER_REGISTRY に connected:true な pull型ソースが存在しないため、
// sourceCount=0・status=COMPLETED のレコードのみが作られる想定（src/lib/ingestion/
// runDailySearch.ts 参照）。実データソースが接続され次第、自然に内訳が埋まっていく。
model SearchRun {
  id         Int             @id @default(autoincrement())
  startedAt  DateTime        @default(now())
  finishedAt DateTime?
  status     SearchRunStatus @default(RUNNING)

  sourceCount      Int @default(0) // 対象になったソース数（connected:true && kind:"pull"）
  succeededSources Int @default(0)
  failedSources    Int @default(0)

  fetchedCount Int @default(0) // 全ソース合計の取得件数
  createdCount Int @default(0) // 新着（新規作成）件数
  updatedCount Int @default(0) // 既存物件の更新件数
  errorCount   Int @default(0) // バリデーション/取込に失敗した行数
  matchCount   Int @default(0) // 生成されたPropertyMatch（通知）件数

  sources SearchRunSource[]
}

// SearchRun のうち、1ソース分の実行内訳。
model SearchRunSource {
  id          Int       @id @default(autoincrement())
  searchRunId Int
  searchRun   SearchRun @relation(fields: [searchRunId], references: [id], onDelete: Cascade)

  source       String // PROVIDER_REGISTRYのid（例: "homes"）
  status       SearchRunSourceStatus
  errorMessage String? // status=FAILEDの場合の例外メッセージ

  fetchedCount       Int @default(0)
  createdCount       Int @default(0)
  updatedCount       Int @default(0)
  errorCount         Int @default(0)
  matchCount         Int @default(0)
  markedUnknownCount Int @default(0) // reconcileListingStatus()でUNKNOWNへ遷移した件数

  createdAt DateTime @default(now())
}

// 収益シミュレーションの「初期値・保存された編集値」
// 実際の売上/利益はUI側で都度計算する（保存はしない）
model SimulationInput {
  id            Int      @id @default(autoincrement())
  propertyId    Int      @unique
  property      Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  nightlyPrice  Int // 想定宿泊単価（円/泊）
  occupancyRate Float // 想定稼働率（0.0〜1.0）
  utilityCost   Int // 水道光熱費（円/月）
  cleaningCost  Int // 清掃費（円/月）
  suppliesCost  Int // 消耗品費（円/月）
  otaFeeRate    Float    @default(0.15) // OTA(Airbnb等)手数料率（0.0〜1.0、売上に対する割合）
  otherCost     Int // その他経費（円/月）
  updatedAt     DateTime @updatedAt
}

// お気に入り（プロトタイプにつきユーザー識別なしの単一ユーザー想定）
model Favorite {
  id         Int      @id @default(autoincrement())
  propertyId Int      @unique
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
}

// 保存検索条件。
//
// フィールド名は検索画面(src/lib/types.ts の SearchFilters)の絞り込み条件と意図的に
// 揃えてあり、src/lib/propertyQuery.ts の buildPropertyWhere() を検索画面・新着マッチング
// 判定の両方から共通で呼び出せるようにしている（ロジックの二重管理を避けるため）。
//
// 認証機能は未実装のため userId は固定値("default-user")を既定値として使う。
// 将来ログイン機能を追加する際、この値を実際のユーザーIDに差し替えるだけで移行できる。
model SavedSearch {
  id      Int     @id @default(autoincrement())
  userId  String  @default("default-user")
  name    String // 例:「廿日市・戸建て・8万円以下」
  enabled Boolean @default(true) // ON/OFFの切り替え

  city           String? // エリア
  rentMax        Int? // 家賃上限
  buildingType   BuildingType? // 戸建て/マンション（nullは指定なし）
  areaSqmMin     Float? // 専有面積下限
  maxAge         Int? // 築年数上限
  stationWalkMax Int? // 駅徒歩上限
  hasParking     Boolean? // true=駐車場必須。null/falseは指定なし

  matches PropertyMatch[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// 「新着物件」が「保存検索条件」に一致したことを記録するテーブル。
// このレコード自体が通知データを兼ねる（readAtが null=未読、日時あり=既読）。
//
// 一致判定は物件が新規作成された（ingestProperty()のcreated===true）ときのみ行う。
// 既存物件の更新（家賃変更など）では作成されない。
//
// 将来の自動化（CSV/APIから取込 → 新規物件判定 → 保存検索条件と照合 → PropertyMatch作成
// → メール/Push通知）に備え、この時点でメール・Push送信は行わず、レコード作成のみ行う。
model PropertyMatch {
  id            Int         @id @default(autoincrement())
  userId        String // 通知の宛先（SavedSearch.userIdと同じ値）
  propertyId    Int
  property      Property    @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  savedSearchId Int
  savedSearch   SavedSearch @relation(fields: [savedSearchId], references: [id], onDelete: Cascade)

  createdAt DateTime  @default(now())
  readAt    DateTime? // 既読日時（未読の場合はnull）

  // 同じ物件×同じ保存検索条件の組み合わせで重複通知が生成されないようにするための制約
  @@unique([propertyId, savedSearchId])
}
