# ==============================================================
# MIYAJIMA STOCK 環境変数
# このファイルを .env.local にコピーして値を設定してください。
#   cp .env.example .env.local
# Vercel では「Settings → Environment Variables」に同じ名前で登録します。
# ==============================================================

# --- Supabase（ブラウザに公開しても安全な値。データは RLS で保護） ---
# Supabase ダッシュボード → Project Settings → API（または Connect）
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# 「Publishable key」（sb_publishable_...）。古いプロジェクトでは anon key でも可
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# --- Claude API（サーバー専用。絶対に NEXT_PUBLIC_ を付けないこと） ---
# https://console.anthropic.com/ → API Keys
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxx
# 解析に使うモデル（省略時: claude-opus-5-5）
# 費用を抑えたい場合は claude-sonnet-5-5 や claude-haiku-5-5 も指定可能
ANTHROPIC_MODEL=claude-opus-5-5
